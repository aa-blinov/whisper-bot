# Telegram
TELEGRAM_BOT_TOKEN=123456:replace-with-the-token-from-botfather
# Твой числовой Telegram ID. Можно несколько через запятую.
ADMIN_ID=123456789

# Postgres. Пароль и DATABASE_URL должны совпадать.
POSTGRES_USER=lazy
POSTGRES_PASSWORD=lazy
POSTGRES_DB=lazy
DATABASE_URL=postgresql://lazy:lazy@postgres:5432/lazy

# Данные: кэш моделей (внутри контейнера /app/data)
DATA_DIR=data
MAX_MEDIA_SECONDS=300

# Очередь (в Docker это имя сервиса)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Сколько секунд результат задачи живёт в Redis, если его никто не забрал.
RESULT_TTL_SECONDS=3600

# Распознавание: GigaAM v3 e2e (русский, с пунктуацией), Whisper (английский)
ASR_MODEL=gigaam-v3-e2e-ctc
ASR_MODEL_EN=whisper-base
ASR_QUANTIZATION=int8
# 0: onnxruntime сам выбирает число потоков. На сервере с 2 vCPU поставь 1
# или 2: иначе потоки дерутся за ядра и минута аудио идёт 19 секунд вместо 6.
ASR_THREADS=0
# 0 отключает прогрев английской модели на старте (экономит ~107 МБ, но
# первый английский запрос будет ждать загрузки).
WARM_UP_EN=1

# Необязательный токен Hugging Face (быстрее скачивание модели)
HF_TOKEN=
